# Copy to .env and fill in from Supabase: Project settings > API.

# Used by the browser. The anon key is public by design; row level security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Bypasses row level security. Used by `npm run seed` on your machine, and by the API
# (server only) to look up a message receiver's email for offline alerts.
# Never prefix with VITE_ and never commit. Add it to Vercel only if you want offline emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Identifies the app to the geocoder, as Nominatim's usage policy requires.
GEOCODER_USER_AGENT=LetMeKnock/0.2 (your contact email or site)

# Optional. Offline message emails through Resend (https://resend.com). These three and
# SUPABASE_SERVICE_ROLE_KEY must be set, otherwise emails are off and messaging still works.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. LetMeKnock <alerts@yourdomain.ca>
NOTIFY_FROM_EMAIL=
# The site's public address, used for the link in the email, e.g. https://your-site.vercel.app
APP_URL=
